# Skill Creator Environment Configuration
# Generated by initial setup

# Slack Integration (configure with your Slack app credentials)
export SKILL_SLACK_WEBHOOK="${SKILL_SLACK_WEBHOOK:-}"
export SKILL_SLACK_SIGNING_SECRET="${SKILL_SLACK_SIGNING_SECRET:-}"

# Daemon Configuration
export SKILL_DAEMON_PORT=3847
export SKILL_DAEMON_URL="http://localhost:3847"

# Skills Location
export SKILLS_ROOT="$HOME/.claude/skills"

# Ensure skills directory exists
mkdir -p "$SKILLS_ROOT"
